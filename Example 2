# 3. 交替求解器 (融入 Tikhonov H2 正则化)
# ============================
class AlternatingSolver:
    def __init__(self, full_xy_dense, x_obs, u_obs, grad_obs, f_known, u_true_grid, xy_b, n_b, neumann_b_true):
        self.full_xy_dense = full_xy_dense
        self.x_obs = x_obs
        self.u_obs = u_obs
        self.grad_obs = grad_obs
        self.f_known = f_known
        
        self.u_bases = nn.ModuleList()
        self.q_bases = nn.ModuleList()
        self.grid_N = 80 
        
        # 接收主程序传来的统一边界数据
        self.xy_b = xy_b
        self.n_b = n_b
        self.neumann_b_true = neumann_b_true

    def get_u(self, x):
        if not self.u_bases: return torch.zeros((x.shape[0], 1), device=device)
        res = torch.zeros((x.shape[0], 1), device=device)
        for b in self.u_bases: res = res + b(x)
        return res

    def get_q(self, x):
        if not self.q_bases: return torch.zeros((x.shape[0], 1), device=device)
        res = torch.zeros((x.shape[0], 1), device=device)
        for b in self.q_bases: res = res + b(x)
        return res
    
    def predict_lap_u(self, x):
        res = torch.zeros((x.shape[0], 1), device=device)
        for b in self.u_bases:
            _, _, lap_b = b.forward_full(x)
            res = res + lap_b
        return res

    def sample_batch(self, batch_size=4500):
        n_uniform = int(batch_size * (3000.0 / 4500.0)) 
        n_adaptive = batch_size - n_uniform
        
        if len(self.u_bases) == 0:
            idx = torch.randperm(len(self.u_obs), device=device)[:batch_size]
        else:
            with torch.no_grad():
                idx_uniform = torch.randperm(len(self.u_obs), device=device)[:n_uniform]
                
                u_curr = self.get_u(self.x_obs)
                q_curr = self.get_q(self.x_obs)
                lap_curr = self.predict_lap_u(self.x_obs)
                
                pde_res = torch.abs(-lap_curr + q_curr * u_curr - self.f_known).squeeze()
                weights = pde_res + pde_res.mean() * 0.5 
                
                idx_adaptive = torch.multinomial(weights, n_adaptive, replacement=False)
                idx = torch.cat([idx_uniform, idx_adaptive])
                
        return self.x_obs[idx], self.u_obs[idx], self.grad_obs[idx], self.f_known[idx]

    # --- Step U ---
    def step_add_u(self, n_neurons):
        x_train, u_train, g_train, f_train = self.sample_batch(4500)
        
        with torch.no_grad():
            u_curr = self.get_u(x_train)
            u_res = u_train - u_curr
            scale_norm = torch.linalg.norm(u_res) + 1e-8
            scale = scale_norm.item() if scale_norm < 1.0 else 1.0
            
            xg = np.linspace(0, 1, self.grid_N); Xg, Yg = np.meshgrid(xg, xg)
            resid_grid = griddata(x_train.cpu().numpy(), (u_res/scale).cpu().numpy().flatten(), (Xg, Yg), fill_value=0)
            q_curr = self.get_q(x_train).detach()
            
        new_basis = SLFNBasis2D(n_neurons).to(device)
        new_basis.init_hybrid(resid_grid, ratio=0.8, freq_scale=4.0)
        
        self.u_bases.append(new_basis)
        new_basis.requires_grad_(True); new_basis.output_weight.requires_grad_(True)
        
        u_old = torch.zeros_like(u_train)
        g_old = torch.zeros_like(g_train)
        lap_u_old = torch.zeros_like(u_train)
        pred_neumann_old = torch.zeros_like(self.neumann_b_true)
        
        with torch.no_grad():
            for b in self.u_bases[:-1]:
                ub, gb, lb = b.forward_full(x_train)
                u_old += ub; g_old += gb; lap_u_old += lb
                
                _, gb_b, _ = b.forward_full(self.xy_b)
                pred_neumann_old += torch.sum(gb_b * self.n_b, dim=1, keepdim=True)
        
        optimizer = torch.optim.Adam(new_basis.parameters(), lr=0.005)
        
        for i in range(500):
            optimizer.zero_grad()
            ub, gb, lb = new_basis.forward_full(x_train)
            
            u_total = u_old + ub
            g_total = g_old + gb
            lap_total = lap_u_old + lb
            
            _, gb_b_new, _ = new_basis.forward_full(self.xy_b)
            pred_neumann_new = torch.sum(gb_b_new * self.n_b, dim=1, keepdim=True)
            
            loss_u = torch.mean(((u_total - u_train) / scale)**2)
            loss_g = torch.mean(((g_total - g_train) / scale)**2)
            
            loss_bc = torch.mean(((pred_neumann_old + pred_neumann_new - self.neumann_b_true) / scale)**2)
            loss_pde = torch.mean(((-lap_total + q_curr * u_total - f_train) / scale)**2)
            
            loss = 1.0*loss_u + 1.0*loss_g + 0.005*loss_pde + 10.0*loss_bc
            loss.backward()
            optimizer.step()
            
        clamp_frequencies(new_basis.linear)
        for p in new_basis.parameters(): p.requires_grad = False
        self.update_coeffs_u(x_train, u_train, g_train, f_train)

    def update_coeffs_u(self, x, u_obs, g_obs, f_obs):
        Phi, Gx, Gy, Lap = [], [], [], []
        with torch.no_grad():
            for b in self.u_bases:
                p, dx, dy, lap = b.get_u_features_grads_laplacian(x)
                Phi.append(p); Gx.append(dx); Gy.append(dy); Lap.append(lap)
            q_curr = self.get_q(x).detach()
                
        Gx_b, Gy_b = [], []
        with torch.no_grad():
            for b in self.u_bases:
                _, dx, dy, _ = b.get_u_features_grads_laplacian(self.xy_b)
                Gx_b.append(dx); Gy_b.append(dy)
        
        Neumann_A = torch.cat(Gx_b, 1) * self.n_b[:, 0:1] + torch.cat(Gy_b, 1) * self.n_b[:, 1:2]
        # Physics residual block (eq. joint_opt_cd), parameter d fixed:  (-Delta phi_j + b phi_j) c_j = f
        Phi_cat = torch.cat(Phi, 1)
        PDE_A = -torch.cat(Lap, 1) + q_curr * Phi_cat
        w_pde = 0.005

        A = torch.cat([10*Phi_cat, torch.cat(Gx,1), torch.cat(Gy,1), 10*Neumann_A, w_pde*PDE_A], dim=0)
        b_vec = torch.cat([10*u_obs, g_obs[:,0:1], g_obs[:,1:2], 10*self.neumann_b_true, w_pde*f_obs], dim=0)
        
        coeffs = Robust_Least_Squares([A], [b_vec], lambda_reg=1e-5)
        curr = 0
        for b in self.u_bases:
            b.output_weight.data = coeffs[curr:curr+b.n_hidden]
            curr += b.n_hidden

    # --- Step Q ---
    def step_add_q(self, n_neurons):
        x_train, _, _, f_train = self.sample_batch(4500)
        
        with torch.no_grad():
            u_curr = self.get_u(x_train).detach()
            lap_u_curr = self.predict_lap_u(x_train).detach()
            q_old = self.get_q(x_train).detach()
            rhs_residual = (f_train + lap_u_curr) - q_old * u_curr
            resid_grid = np.zeros((self.grid_N, self.grid_N))

        new_basis = SLFNBasis2D(n_neurons).to(device)
        new_basis.init_hybrid(resid_grid, ratio=0.0, freq_scale=1.5)
        
        self.q_bases.append(new_basis)
        new_basis.requires_grad_(True); new_basis.output_weight.requires_grad_(True)
        
        scale_q_norm = torch.linalg.norm(rhs_residual) + 1e-8
        scale_q = scale_q_norm.item() if scale_q_norm < 1.0 else 1.0
        
        optimizer = torch.optim.Adam(new_basis.parameters(), lr=0.02)
        
        for i in range(800):
            optimizer.zero_grad()
            q_sub = new_basis(x_train)
            loss_fit = torch.mean(((q_sub * u_curr - rhs_residual) / scale_q)**2)
            
            w_mag = torch.mean(new_basis.linear.weight**2)
            loss_freq = 5e-3 * w_mag 
            
            loss = loss_fit + loss_freq
            loss.backward()
            optimizer.step()

        clamp_frequencies(new_basis.linear)
        for p in new_basis.parameters(): p.requires_grad = False

        with torch.no_grad():
            rhs_target = f_train + lap_u_curr
            Phi_u_list = []
            for b in self.q_bases:
                phi = b.get_features(x_train)
                Phi_u_list.append(phi * u_curr)
            
            A = torch.cat(Phi_u_list, dim=1)
            coeffs = Robust_Least_Squares([A], [rhs_target], lambda_reg=1e-4)
            curr = 0
            for b in self.q_bases:
                b.output_weight.data = coeffs[curr:curr+b.n_hidden].reshape(-1, 1)
                curr += b.n_hidden

    # --- [灵魂核心：Joint Polishing] ---
    def joint_polishing(self, lambda_reg=1e-4):
        if not self.q_bases: return
        print(f"    >>> Joint Polishing (with Tikhonov H2 Regularization: lambda={lambda_reg})...")
        
        params = [p for b in self.u_bases for p in b.parameters()] + \
                 [p for b in self.q_bases for p in b.parameters()]
        for p in params: p.requires_grad_(True)
        
        optimizer = torch.optim.LBFGS(params, lr=0.1, max_iter=50, line_search_fn="strong_wolfe")
        x_bat, u_bat, _, f_bat = self.sample_batch(4000)
        
        def closure():
            optimizer.zero_grad()
            
            u = torch.zeros((x_bat.shape[0], 1), device=device)
            lap_u = torch.zeros((x_bat.shape[0], 1), device=device)
            for b in self.u_bases:
                ub, _, lap_b = b.forward_full(x_bat) 
                u = u + ub
                lap_u = lap_u + lap_b
                
            q = torch.zeros((x_bat.shape[0], 1), device=device)
            dq_dx = torch.zeros((x_bat.shape[0], 1), device=device)
            dq_dy = torch.zeros((x_bat.shape[0], 1), device=device)
            d2q_dx2 = torch.zeros((x_bat.shape[0], 1), device=device)
            d2q_dy2 = torch.zeros((x_bat.shape[0], 1), device=device)
            d2q_dxdy = torch.zeros((x_bat.shape[0], 1), device=device)
            
            for b in self.q_bases:
                z = b.linear(x_bat)
                phi = torch.sin(z)
                dphi_dz = torch.cos(z)
                d2phi_dz2 = -torch.sin(z)
                
                W = b.linear.weight
                W0 = W[:, 0:1].T  
                W1 = W[:, 1:2].T  
                w_out = b.output_weight
                
                q = q + (phi @ w_out)
                dq_dx = dq_dx + ((dphi_dz * W0) @ w_out)
                dq_dy = dq_dy + ((dphi_dz * W1) @ w_out)
                d2q_dx2 = d2q_dx2 + ((d2phi_dz2 * (W0**2)) @ w_out)
                d2q_dy2 = d2q_dy2 + ((d2phi_dz2 * (W1**2)) @ w_out)
                d2q_dxdy = d2q_dxdy + ((d2phi_dz2 * (W0 * W1)) @ w_out)
            
            loss_data = torch.mean((u - u_bat)**2)
            loss_pde = torch.mean((-lap_u + q * u - f_bat)**2)
            
            grad_u_b = torch.zeros((self.xy_b.shape[0], 2), device=device)
            for b in self.u_bases:
                _, gb_b, _ = b.forward_full(self.xy_b)
                grad_u_b = grad_u_b + gb_b
            pred_neumann = torch.sum(grad_u_b * self.n_b, dim=1, keepdim=True)
            loss_bc = torch.mean((pred_neumann - self.neumann_b_true)**2)
            
            loss_H2_q = torch.mean(q**2 + dq_dx**2 + dq_dy**2 + d2q_dx2**2 + d2q_dy2**2 + 2*(d2q_dxdy**2))
            
            loss = loss_data + loss_pde + 10.0 * loss_bc + lambda_reg * loss_H2_q
            loss.backward()
            return loss
            
        optimizer.step(closure)
        for b in self.u_bases: clamp_frequencies(b.linear)
        for b in self.q_bases: clamp_frequencies(b.linear)
        for p in params: p.requires_grad_(False)

    def solve(self, stages=5):
        print("=== Solver Start ===")
        for s in range(stages):
            print(f"\n--- Stage {s+1} ---")
            self.step_add_u(30 + s*5)
            self.step_add_q(30 + s*5)
            
            if (s+1)%2 == 0:
                self.joint_polishing(lambda_reg=1e-6)

