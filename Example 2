# 1.5. Sobolev Denoising (已升级：加入边界约束)
# ============================
class DenoisingNet(nn.Module):
    def __init__(self, n_hidden=128):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(2, n_hidden),
            nn.Tanh(),
            nn.Linear(n_hidden, n_hidden),
            nn.Tanh(),
            nn.Linear(n_hidden, n_hidden),
            nn.Tanh(),
            nn.Linear(n_hidden, 1)
        )
        
    def forward(self, x):
        return self.net(x)

def train_denoiser(x_train, u_train, grad_train, xy_b, n_b, neumann_b_true, epochs=2500, lr=0.001):
    print(f"\n=== Step 0: Pre-processing (Sobolev Denoising + Neumann BC) ===")
    
    x_in = x_train.clone().detach().requires_grad_(True)
    xy_b_in = xy_b.clone().detach().requires_grad_(True) # 边界点也需要求导
    
    model = DenoisingNet(n_hidden=128).to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)
    scheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=500, gamma=0.95)
    
    for i in range(epochs):
        optimizer.zero_grad()
        
        # 1. 内部观测点 Loss
        u_pred = model(x_in)
        grads = torch.autograd.grad(u_pred, x_in, 
                                    grad_outputs=torch.ones_like(u_pred), 
                                    create_graph=True)[0]
        
        loss_u = torch.mean((u_pred - u_train)**2)
        loss_g = torch.mean((grads - grad_train)**2)
        
        # 2. 边界约束 Loss
        u_b_pred = model(xy_b_in)
        grads_b = torch.autograd.grad(u_b_pred, xy_b_in, 
                                      grad_outputs=torch.ones_like(u_b_pred), 
                                      create_graph=True)[0]
        pred_neumann = torch.sum(grads_b * n_b, dim=1, keepdim=True)
        loss_bc = torch.mean((pred_neumann - neumann_b_true)**2)
        
        # 边界约束权重给得高一些 (10.0)，确保边界不崩溃
        loss = loss_u + 0 * loss_g + 10.0 * loss_bc 
        
        loss.backward()
        optimizer.step()
        scheduler.step()
            
    print(f"  [Denoiser] Final Loss: {loss.item():.6f}")
    
    def get_denoised_data(x_input):
        with torch.enable_grad(): 
            x_temp = x_input.clone().detach().requires_grad_(True)
            u_p = model(x_temp)
            g_p = torch.autograd.grad(u_p, x_temp, grad_outputs=torch.ones_like(u_p), create_graph=False)[0]
        return u_p.detach(), g_p.detach()
        
    return get_denoised_data

# ============================
# 2. 神经网络基底 (包含频谱分析)
# ============================
class SLFNBasis2D(nn.Module):
    def __init__(self, n_hidden):
        super().__init__()
        self.n_hidden = n_hidden
        self.linear = nn.Linear(2, n_hidden)
        self.output_weight = nn.Parameter(torch.zeros(n_hidden, 1, dtype=torch.float64), requires_grad=False)
        
    def get_features(self, x):
        return torch.sin(self.linear(x))

    def init_hybrid(self, residual_grid, ratio=0.7, freq_scale=4.0):
        if residual_grid is None or np.all(residual_grid == 0):
            nn.init.xavier_uniform_(self.linear.weight)
            nn.init.uniform_(self.linear.bias, -np.pi, np.pi)
            clamp_frequencies(self.linear)
            return
        
        F = np.fft.fft2(residual_grid)
        F_mag = np.abs(np.fft.fftshift(F))
        N_grid = residual_grid.shape[0]
        n_fft = int(self.n_hidden * ratio)
        n_rand = self.n_hidden - n_fft
        
        indices = np.argsort(F_mag.flatten())[-n_fft:]
        freqs_fft = []
        for idx in indices:
            iy, ix = np.unravel_index(idx, (N_grid, N_grid))
            fx = (ix - N_grid//2) * 2 * np.pi 
            fy = (iy - N_grid//2) * 2 * np.pi 
            freqs_fft.append([fx, fy])
            
        freqs_rand = (torch.rand(n_rand, 2, dtype=torch.float64, device=device) * 2 - 1) * freq_scale * np.pi
        W_final = torch.cat([torch.tensor(freqs_fft, device=device), freqs_rand], dim=0) if n_fft > 0 else freqs_rand
            
        with torch.no_grad():
            self.linear.weight.data = W_final
            self.linear.bias.data.uniform_(-np.pi, np.pi)
        clamp_frequencies(self.linear)

    def get_u_features_grads_laplacian(self, x):
        z = self.linear(x)
        phi = torch.sin(z)
        dphi_dz = torch.cos(z)
        W = self.linear.weight
        W0 = W[:, 0:1].T; W1 = W[:, 1:2].T
        dphi_dx = dphi_dz * W0
        dphi_dy = dphi_dz * W1
        d2phi_dz2 = -torch.sin(z)
        lap_phi = d2phi_dz2 * (W0**2 + W1**2)
        return phi, dphi_dx, dphi_dy, lap_phi

    def forward(self, x):
        return self.get_features(x) @ self.output_weight
    
    def forward_full(self, x):
        phi, dx, dy, lap = self.get_u_features_grads_laplacian(x)
        w = self.output_weight
        return phi @ w, torch.cat([dx@w, dy@w], dim=1), lap @ w

