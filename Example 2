class GroundTruthExample5_2:
    def __init__(self, N=200): 
        self.N = N
        self.x = np.linspace(0, 1, N)
        self.y = np.linspace(0, 1, N)
        self.X, self.Y = np.meshgrid(self.x, self.y)
        self.dx = 1.0 / (N - 1)
        self.xy_dense = np.stack([self.X.flatten(), self.Y.flatten()], axis=1)
        
        # --- 1. 修改 u_true ---
        self.u_true = 1.0 + np.sin(self.X) * np.sin(self.Y)
        
        # --- 2. 保持 q_true 不变 ---
        self.q_true = 1.0 + 0.5 * np.sin(np.pi * self.X) * np.sin(np.pi * self.Y)
        
        # --- 3. 分析计算准确的梯度和 f_true (匹配新的 u) ---
        self.u_x_true = np.cos(self.X) * np.sin(self.Y)
        self.u_y_true = np.sin(self.X) * np.cos(self.Y)
        self.lap_u_true = -2.0 * np.sin(self.X) * np.sin(self.Y)
        
        # 方程: -\Delta u + q u = f
        self.f_true = -self.lap_u_true + self.q_true * self.u_true
        
        # 插值器
        self.u_interp = RegularGridInterpolator((self.y, self.x), self.u_true, method='cubic')
        self.ux_interp = RegularGridInterpolator((self.y, self.x), self.u_x_true, method='cubic')
        self.uy_interp = RegularGridInterpolator((self.y, self.x), self.u_y_true, method='cubic')
        self.f_interp = RegularGridInterpolator((self.y, self.x), self.f_true, method='cubic')
        self.q_interp = RegularGridInterpolator((self.y, self.x), self.q_true, method='cubic')

    def generate_observation_data(self, n_samples, noise_level=0.01):
        x_samples = np.random.rand(n_samples, 2)
        yx_samples = np.stack([x_samples[:, 1], x_samples[:, 0]], axis=1)
        
        u_clean = self.u_interp(yx_samples).reshape(-1, 1)
        ux_clean = self.ux_interp(yx_samples).reshape(-1, 1)
        uy_clean = self.uy_interp(yx_samples).reshape(-1, 1)
        f_clean = self.f_interp(yx_samples).reshape(-1, 1)
        
        def add_noise(signal, level):
            std = np.std(signal) + 1e-8
            return signal + np.random.randn(*signal.shape) * level * std 
            
        u_obs = add_noise(u_clean, noise_level)
        ux_obs = add_noise(ux_clean, noise_level) 
        uy_obs = add_noise(uy_clean, noise_level)
        f_known = add_noise(f_clean, noise_level * 0)  # f 无噪声
        
        return (self.xy_dense, 
                to_tensor(x_samples), 
                to_tensor(u_obs), 
                to_tensor(np.hstack([ux_obs, uy_obs])),
                to_tensor(f_known))

# --- 提取统一的边界数据生成函数 ---
def get_boundary_data(full_xy_dense):
    mask_left = (full_xy_dense[:,0] == 0)
    mask_right = (full_xy_dense[:,0] == 1)
    mask_bottom = (full_xy_dense[:,1] == 0)
    mask_top = (full_xy_dense[:,1] == 1)

    xy_left = full_xy_dense[mask_left]
    n_left = np.zeros_like(xy_left); n_left[:, 0] = -1
    
    xy_right = full_xy_dense[mask_right]
    n_right = np.zeros_like(xy_right); n_right[:, 0] = 1
    
    xy_bottom = full_xy_dense[mask_bottom]
    n_bottom = np.zeros_like(xy_bottom); n_bottom[:, 1] = -1
    
    xy_top = full_xy_dense[mask_top]
    n_top = np.zeros_like(xy_top); n_top[:, 1] = 1

    xy_b_np = np.vstack([xy_left, xy_right, xy_bottom, xy_top])
    n_b_np = np.vstack([n_left, n_right, n_bottom, n_top])
    
    # 真实 Neumann 边界解析解: u_x = cos(x)sin(y), u_y = sin(x)cos(y)
    grad_b_np = np.zeros_like(xy_b_np)
    grad_b_np[:, 0] = np.cos(xy_b_np[:, 0]) * np.sin(xy_b_np[:, 1])
    grad_b_np[:, 1] = np.sin(xy_b_np[:, 0]) * np.cos(xy_b_np[:, 1])
    
    # 内积得到法向导数 du/dn
    neumann_b_np = np.sum(grad_b_np * n_b_np, axis=1, keepdims=True)

    return to_tensor(xy_b_np), to_tensor(n_b_np), to_tensor(neumann_b_np)


