# Band-limit cap omega_max: input-layer frequencies are projected to |omega| <= OMEGA_MAX.
OMEGA_MAX = 30 * np.pi
def clamp_frequencies(linear, w_max=OMEGA_MAX):
    with torch.no_grad():
        W = linear.weight.data
        nrm = W.norm(dim=1, keepdim=True)
        W.mul_((w_max / nrm.clamp_min(1e-12)).clamp(max=1.0))

def to_tensor(x, requires_grad=False):
    t = torch.tensor(x, dtype=torch.float64, device=device)
    if requires_grad: t.requires_grad_(True)
    return t

# --- [工具] 稳健的最小二乘求解器 (投影矩阵优化) ---
def Robust_Least_Squares(A_list, b_list, weights=None, lambda_reg=1e-6):
    if weights is None: weights = [1.0] * len(A_list)
    
    A_scaled_list = []
    b_scaled_list = []
    
    for i, (A, b, w) in enumerate(zip(A_list, b_list, weights)):
        A_scaled_list.append(A * w)
        b_scaled_list.append(b * w)
        
    A_final = torch.cat(A_scaled_list, dim=0)
    b_final = torch.cat(b_scaled_list, dim=0)
    
    # 求解 (A^T A + lambda I) x = A^T b
    ATA = A_final.T @ A_final
    ATb = A_final.T @ b_final
    reg = lambda_reg * torch.eye(ATA.shape[0], device=device)
    
    try:
        sol = torch.linalg.solve(ATA + reg, ATb)
    except:
        sol = torch.linalg.lstsq(A_final, b_final, driver='gels').solution
        
    return sol

